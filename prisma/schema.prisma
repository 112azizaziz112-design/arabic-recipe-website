generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  username String @unique
  password String
  isAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  comments Comment[]
  favorites Favorite[]
}

model Country {
  id String @id @default(cuid())
  name String @unique
  recipes Recipe[]
}

model Recipe {
  id String @id @default(cuid())
  title String
  image String
  ingredients String
  steps String
  time Int
  difficulty String
  description String
  category String? // هذا الجديد للتصنيف
  countryId String // هذا موجود أصلاً للدولة
  createdAt DateTime @default(now())
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  comments Comment[]
  favorites Favorite[]
}

model Comment {
  id String @id @default(cuid())
  text String
  createdAt DateTime @default(now())
  userId String
  recipeId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Favorite {
  id String @id @default(cuid())
  userId String
  recipeId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}